# Public site URL used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.lend.sa

# Business-interest form (server only — never exposed to the browser).
# Inbox that receives every submission.
LEADS_TO_EMAIL=partner@lend.sa
# Verified sender on your Resend domain, e.g. "Lend <no-reply@lend.sa>".
LEADS_FROM_EMAIL=
# Resend API key (https://resend.com/api-keys).
RESEND_API_KEY=
